<Slide style={{ width: 1280, height: 720, background: '#FFFFFF' }}>
  {/* A3 页眉 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', paddingLeft: 40, paddingRight: 40, justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>超声胎儿头围检测 · 教学课件</Text>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>第 3 章 · 实验与结果分析</Text>
  </Box>
  {/* B 标题块 */}
  <Box style={{ position: 'absolute', top: 96, left: 40, width: 1200, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 34, background: '#1E4FA8', borderRadius: 2 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>训练过程：损失收敛与精度爬升</Text>
    <Text style={{ fontSize: 16, color: '#8B97A8', marginLeft: 12 }}>YOLO11n 训练曲线（results.png）</Text>
  </Box>
  {/* C 内容区 */}
  <Box style={{ position: 'absolute', top: 156, left: 40, width: 1200, flexDirection: 'row', gap: 24 }}>
    {/* 左大图 */}
    <Box style={{ width: 730, flexDirection: 'column' }}>
      <Image src="assets/results_yolo11.png" style={{ width: 730, height: 394, objectFit: 'contain', borderRadius: 10, border: '1px solid #D6DCE5', background: '#FFFFFF' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 8 }}>左列：训练损失（box / cls / dfl）；右列：验证精度（P / R / mAP50 / mAP50-95）</Text>
    </Box>
    {/* 右侧洞察 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>① 损失快速收敛</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>三类损失约 10 轮内陡降并趋平稳，验证损失无回升——未出现过拟合。</Text>
      </Box>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>② 精度迅速到位</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>mAP50 约 10 轮即达 0.99+，最终 0.995；Precision / Recall 双双逼近 1.0。</Text>
      </Box>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>③ 瓶颈在高 IoU 区间</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>mAP50-95 从 0.87 缓升至 0.95——框的边界精细度才是继续提升的方向。</Text>
      </Box>
    </Box>
  </Box>
  {/* 底部结论条 */}
  <Box style={{ position: 'absolute', top: 590, left: 40, width: 1200, height: 54, background: '#E8EFF8', borderRadius: 10, justifyContent: 'center', paddingLeft: 24 }}>
    <Text style={{ fontSize: 20, color: '#0E3F8C' }}><span style={{ fontWeight: 'bold' }}>解读：</span>单类、大目标、形态规律的检测任务相对容易；mAP50-95 的缓慢爬升提示后续应关注椭圆边界的精细回归。</Text>
  </Box>
  {/* D 页脚 */}
  <Box style={{ position: 'absolute', top: 668, left: 40, width: 1200, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>HC18 胎儿头围检测项目 · 肖雄涛</Text>
    <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold' }}>13 / 19</Text>
  </Box>
