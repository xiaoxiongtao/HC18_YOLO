<Slide style={{ width: 1280, height: 720, background: '#FFFFFF' }}>
  {/* A3 页眉 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', paddingLeft: 40, paddingRight: 40, justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>超声胎儿头围检测 · 教学课件</Text>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>第 3 章 · 实验与结果分析</Text>
  </Box>
  {/* B 标题块 */}
  <Box style={{ position: 'absolute', top: 96, left: 40, width: 1200, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 34, background: '#1E4FA8', borderRadius: 2 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>头围估计精度：MAD / DSC / 相关性</Text>
    <Text style={{ fontSize: 16, color: '#8B97A8', marginLeft: 12 }}>以检测框拟合椭圆换算毫米后对比官方真值</Text>
  </Box>
  {/* C 内容区 */}
  <Box style={{ position: 'absolute', top: 156, left: 40, width: 1200, flexDirection: 'row', gap: 24 }}>
    {/* 左大图 */}
    <Box style={{ width: 620, flexDirection: 'column' }}>
      <Image src="assets/comparison_plots.png" style={{ width: 620, height: 447, objectFit: 'contain', borderRadius: 10, border: '1px solid #D6DCE5', background: '#FFFFFF' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 8 }}>compare.py 输出的四联对比图（检测精度 / 头围误差 / Dice / 相关性）</Text>
    </Box>
    {/* 右侧 KPI */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#1E4FA8' }}>2.03</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>MAD（YOLOv8）vs 2.39（YOLO11）</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.5, marginTop: 2 }}>相对平均头围 174 mm，误差约 1.2–1.4%，头围估计相当可靠。</Text>
        </Box>
      </Box>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#1E4FA8' }}>0.97</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>DSC ≈ 0.970（两模型一致）</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.5, marginTop: 2 }}>预测椭圆与真实椭圆区域高度重叠，形状还原质量好。</Text>
        </Box>
      </Box>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#1E4FA8' }}>0.999</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>Pearson r ≈ 0.999</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.5, marginTop: 2 }}>预测与真值接近完全线性，无系统性高估或低估。</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  {/* 底部结论条 */}
  <Box style={{ position: 'absolute', top: 614, left: 40, width: 1200, height: 42, background: '#E8EFF8', borderRadius: 8, justifyContent: 'center', paddingLeft: 24 }}>
    <Text style={{ fontSize: 19, color: '#0E3F8C' }}><span style={{ fontWeight: 'bold' }}>教学要点：</span>检测框好，头围才准——框的边界误差会通过椭圆周长直接传递到毫米级测量结果。</Text>
  </Box>
  {/* D 页脚 */}
  <Box style={{ position: 'absolute', top: 668, left: 40, width: 1200, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>HC18 胎儿头围检测项目 · 肖雄涛</Text>
    <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold' }}>15 / 19</Text>
  </Box>
</Slide>
