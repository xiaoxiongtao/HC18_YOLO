<Slide style={{ width: 1280, height: 720, background: '#FFFFFF' }}>
  {/* A3 页眉 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', paddingLeft: 40, paddingRight: 40, justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>超声胎儿头围检测 · 教学课件</Text>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>第 1 章 · 临床背景与数据</Text>
  </Box>
  {/* B 标题块 */}
  <Box style={{ position: 'absolute', top: 96, left: 40, width: 1200, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 34, background: '#1E4FA8', borderRadius: 2 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>HC18 数据集：ISBI 2018 挑战赛</Text>
    <Text style={{ fontSize: 16, color: '#8B97A8', marginLeft: 12 }}>来源：Zenodo · records/1327317</Text>
  </Box>
  {/* C 内容区 */}
  <Box style={{ position: 'absolute', top: 156, left: 40, width: 1200, flexDirection: 'row', gap: 28 }}>
    {/* 左 KPI 列 */}
    <Box style={{ width: 620, flexDirection: 'column', gap: 18 }}>
      <Box style={{ flexDirection: 'row', gap: 18 }}>
        <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 12, padding: 20, border: '1px solid #D6DCE5' }}>
          <Text style={{ fontSize: 66, fontWeight: 'bold', color: '#1E4FA8' }}>999</Text>
          <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 4 }}>训练图像（含掩膜标注）</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 12, padding: 20, border: '1px solid #D6DCE5' }}>
          <Text style={{ fontSize: 66, fontWeight: 'bold', color: '#1E4FA8' }}>335</Text>
          <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 4 }}>测试图像（无标注）</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 12, padding: 20, border: '1px solid #D6DCE5' }}>
          <Text style={{ fontSize: 66, fontWeight: 'bold', color: '#1E4FA8' }}>806</Text>
          <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 4 }}>位病人（部分含多次扫描）</Text>
        </Box>
      </Box>
      <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: 20, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>数据规格与官方真值</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>· 800×540 单通道灰度超声图像{'\n'}· 官方提供每张图的像素尺寸 0.049–0.393 mm/px{'\n'}· 头围真值范围 44.3 – 346.4 mm（均值 174.4 mm）{'\n'}· 覆盖不同孕龄、图像质量与超声伪影</Text>
      </Box>
      <Box style={{ background: '#E8EFF8', borderRadius: 12, padding: 18, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 19, color: '#0E3F8C', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold' }}>关键设计：</span>按病人而非按图像划分训练 / 验证集（793 / 206），避免同一病人的多张扫描同时出现在两端，造成数据泄漏与虚高的评估结果。</Text>
      </Box>
    </Box>
    {/* 右侧标注分布图 */}
    <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
      <Image src="assets/labels_yolo11.jpg" style={{ width: 400, height: 400, borderRadius: 10, border: '1px solid #D6DCE5' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 10 }}>训练集检测框分布：目标居中、宽高强相关（类椭圆）</Text>
    </Box>
  </Box>
  {/* D 页脚 */}
  <Box style={{ position: 'absolute', top: 668, left: 40, width: 1200, flexDirection: 'row', justifyContent: 'space-between' }}>
