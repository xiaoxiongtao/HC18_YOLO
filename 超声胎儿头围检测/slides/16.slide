<Slide style={{ width: 1280, height: 720, background: '#FFFFFF' }}>
  {/* A3 页眉 */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', paddingLeft: 40, paddingRight: 40, justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>超声胎儿头围检测 · 教学课件</Text>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>第 3 章 · 实验与结果分析</Text>
  </Box>
  {/* B 标题块 */}
  <Box style={{ position: 'absolute', top: 96, left: 40, width: 1200, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Box style={{ width: 8, height: 34, background: '#1E4FA8', borderRadius: 2 }} />
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>检测结果可视化：模型看到了什么</Text>
    <Text style={{ fontSize: 16, color: '#8B97A8', marginLeft: 12 }}>YOLO11n · 验证集预测（val_batch0_pred）</Text>
  </Box>
  {/* C 内容区 */}
  <Box style={{ position: 'absolute', top: 156, left: 40, width: 1200, flexDirection: 'row', gap: 24 }}>
    {/* 左大图 */}
    <Box style={{ width: 710, flexDirection: 'column' }}>
      <Image src="assets/val_pred_yolo11.jpg" style={{ width: 710, height: 480, objectFit: 'cover', borderRadius: 10, border: '1px solid #D6DCE5' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 8 }}>验证集 16 张预测：蓝色框为 fetal_head 检测结果，右上角为置信度</Text>
    </Box>
    {/* 右侧观察要点 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>① 全检出</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>该批次全部图像检出胎头（Recall = 1.0），置信度普遍 0.7–1.0。</Text>
      </Box>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>② 困难样本也稳</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>小孕周小胎头、混响伪影、体位偏斜等困难样本仍被稳定框选。</Text>
      </Box>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, padding: 16, border: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>③ 框即测量入口</Text>
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>框贴合颅骨椭圆轮廓，可直接进入“拟合椭圆 → 换算毫米”环节。</Text>
      </Box>
    </Box>
  </Box>
  {/* 底部流程条 */}
  <Box style={{ position: 'absolute', top: 662, left: 40, width: 1200, height: 44, background: '#0E3F8C', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
    <Text style={{ fontSize: 19, color: '#FFFFFF', fontWeight: 'bold' }}>预测框 → 拟合椭圆 → 周长 × 像素尺寸 → 头围（mm）</Text>
  </Box>
  <Box style={{ position: 'absolute', top: 668, right: 40 }}>
    <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold', opacity: 0.9 }}>16 / 19</Text>
  </Box>
</Slide>
